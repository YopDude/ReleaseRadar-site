---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Docs - ReleaseRadar">
  <section class="mx-auto max-w-6xl px-5 py-16 md:py-20">
    <h1 class="text-4xl font-semibold tracking-tight md:text-5xl">Docs</h1>
    <p class="mt-4 max-w-2xl text-white/65 leading-relaxed">
      Quick start docs live here. Keeping it simple and practical.
    </p>

    <div class="mt-10 grid gap-5 md:grid-cols-3">
      {[
        {
          title: "Getting started",
          body: "Install, launch, add your first items.",
        },
        {
          title: "Imports (MAL / AniList)",
          body: "Pull your existing lists in and pick up where you left off.",
        },
        {
          title: "Notifications",
          body: "Choose what matters: game start, game end, releases, etc.",
        },
        {
          title: "Custom web tracking",
          body: "Track blog posts, product pages, restocks, price changes.",
        },
        {
          title: "Providers",
          body: "Where data comes from and how to switch sources.",
        },
        {
          title: "FAQ",
          body: "Common questions and quick fixes.",
        },
      ].map((c) => (
        <div class="rounded-3xl border border-white/10 bg-white/5 p-6">
          <div class="text-sm font-semibold">{c.title}</div>
          <p class="mt-3 text-sm text-white/65 leading-relaxed">{c.body}</p>
          <div class="mt-5 rounded-2xl bg-black/25 p-4 ring-1 ring-white/10">
            <div class="text-xs text-white/55">Status</div>
            <div class="mt-1 text-sm text-white/75">Coming soon</div>
          </div>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>
