---
import BaseLayout from "../layouts/BaseLayout.astro";

// Placeholder patch notes.
// Later we can wire this to markdown files or a small JSON feed.
const notes = [
  {
    version: "0.1.0",
    date: "(placeholder)",
    items: [
      "Initial public site",
      "Animated homepage (placeholders)",
      "Downloads + docs stubs",
    ],
  },
];
---

<BaseLayout title="Patch notes — ReleaseRadar">
  <section class="mx-auto max-w-6xl px-5 py-16 md:py-20">
    <h1 class="text-4xl font-semibold tracking-tight md:text-5xl">Patch notes</h1>
    <p class="mt-4 max-w-2xl text-white/65 leading-relaxed">
      What changed, when it changed.
    </p>

    <div class="mt-10 space-y-5">
      {notes.map((n) => (
        <div class="rounded-3xl border border-white/10 bg-white/5 p-6">
          <div class="flex flex-wrap items-baseline justify-between gap-3">
            <div class="text-lg font-semibold">v{n.version}</div>
            <div class="text-xs text-white/50">{n.date}</div>
          </div>
          <ul class="mt-4 space-y-2 text-sm text-white/65">
            {n.items.map((it) => (
              <li>• {it}</li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class="mt-10 rounded-3xl border border-white/10 bg-black/25 p-6 ring-1 ring-white/10">
      <div class="text-sm font-semibold">Next</div>
      <p class="mt-2 text-sm text-white/65 leading-relaxed">
        We can power this page from markdown files so you can add release notes without touching code.
      </p>
    </div>
  </section>
</BaseLayout>
