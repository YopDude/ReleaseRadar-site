---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Contact - ReleaseRadar">
  <section class="mx-auto max-w-6xl px-5 py-16 md:py-20">
    <h1 class="text-4xl font-semibold tracking-tight md:text-5xl">Contact</h1>
    <p class="mt-4 max-w-2xl text-white/65 leading-relaxed">
      For now, the easiest way is email.
    </p>

    <div class="mt-10 max-w-2xl rounded-3xl border border-white/10 bg-white/5 p-8">
      <div class="text-sm font-semibold">Email</div>
      <p class="mt-2 text-sm text-white/65">
        Replace this placeholder with your contact email.
      </p>
      <div class="mt-4 rounded-2xl bg-black/25 p-4 text-sm text-white/80 ring-1 ring-white/10">
        you@example.com
      </div>

      <div class="mt-8 text-xs text-white/50">
        (We can swap this to a form later, but GitHub Pages is static, so email keeps it simple.)
      </div>
    </div>
  </section>
</BaseLayout>
