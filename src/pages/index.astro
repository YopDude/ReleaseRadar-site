---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero";
import SectionReveal from "../components/SectionReveal";
import StickyStory from "../components/StickyStory";

const baseRaw = import.meta.env.BASE_URL || '/';
const base = baseRaw.endsWith('/') ? baseRaw : `${baseRaw}/`;
---

<BaseLayout
  title="ReleaseRadar"
  description="ReleaseRadar monitors updates across anime, manga, movies, TV, sports, and custom sources."
>
  <div class="relative">
    <Hero client:load />
  </div>

  <StickyStory client:load baseUrl={base} />

  <SectionReveal client:visible className="mx-auto max-w-6xl px-5 py-20" id="how">
    <div class="grid gap-10 md:grid-cols-2 md:items-start">
      <div>
        <h2 class="text-3xl font-semibold tracking-tight md:text-4xl">
          Everything updates, but nothing tracks properly.
        </h2>
        <p class="mt-5 text-white/65 leading-relaxed">
          Anime drops on one platform. Sports scores update somewhere else. Movies release unnoticed.
        </p>
        <p class="mt-4 text-white/65 leading-relaxed">
          You end up checking five different places - or missing things entirely.
        </p>
      </div>

      <div class="rounded-3xl border border-white/10 bg-white/5 p-6">
        <div class="text-sm font-semibold text-white/85">The fix</div>
        <h3 class="mt-2 text-2xl font-semibold">Clear updates. No noise.</h3>
        <p class="mt-4 text-white/65 leading-relaxed">
          ReleaseRadar only marks something as new when it actually changes.
        </p>
        <ul class="mt-5 space-y-2 text-sm text-white/65">
          <li>• No fake updates</li>
          <li>• No duplicate alerts</li>
          <li>• No guessing “maybe something changed”</li>
        </ul>
        <div class="mt-5 rounded-2xl bg-black/25 p-4 ring-1 ring-white/10">
          <div class="text-xs text-white/55">Rule of thumb</div>
          <div class="mt-1 text-sm font-semibold text-white/90">
            If it shows up as new, it's new.
          </div>
        </div>
      </div>
    </div>
  </SectionReveal>

  <SectionReveal client:visible className="mx-auto max-w-6xl px-5 py-20">
    <h2 class="text-3xl font-semibold tracking-tight md:text-4xl">
      Track across domains. Not just one niche.
    </h2>
    <p class="mt-4 max-w-2xl text-white/65 leading-relaxed">
      Start simple. Add things you care about. Later, if you want, fine-tune notifications,
      grouping, and refresh behaviour.
    </p>

    <div class="mt-10 grid gap-5 md:grid-cols-2">
      <div class="rounded-3xl border border-white/10 bg-white/5 p-6">
        <div class="flex items-center justify-between">
          <div class="text-sm font-semibold">Anime</div>
          <span class="rounded-full bg-white/10 px-2 py-0.5 text-[11px] text-white/70 ring-1 ring-white/10">
            Import
          </span>
        </div>
        <p class="mt-3 text-white/65 leading-relaxed">
          Upcoming episodes, air dates, streaming releases. Import your profile lists from
          MyAnimeList or AniList - no rebuilding everything manually.
        </p>
        <div class="mt-5 rounded-2xl bg-black/25 p-4 ring-1 ring-white/10">
          <div class="text-xs text-white/55">Screenshot idea</div>
          <div class="mt-1 text-sm text-white/80">
            Main dashboard showing anime cards grouped by day.
          </div>
        </div>
      </div>

      <div class="rounded-3xl border border-white/10 bg-white/5 p-6">
        <div class="flex items-center justify-between">
          <div class="text-sm font-semibold">Manga</div>
          <span class="rounded-full bg-white/10 px-2 py-0.5 text-[11px] text-white/70 ring-1 ring-white/10">
            Import
          </span>
        </div>
        <p class="mt-3 text-white/65 leading-relaxed">
          Monitor series and detect new chapters automatically. Import your existing MAL or
          AniList manga lists and pick up where you left off.
        </p>
        <div class="mt-5 rounded-2xl bg-black/25 p-4 ring-1 ring-white/10">
          <div class="text-xs text-white/55">Screenshot idea</div>
          <div class="mt-1 text-sm text-white/80">
            Add dialog with an import section expanded.
          </div>
        </div>
      </div>

      <div class="rounded-3xl border border-white/10 bg-white/5 p-6">
        <div class="flex items-center justify-between">
          <div class="text-sm font-semibold">Sports</div>
          <span class="rounded-full bg-white/10 px-2 py-0.5 text-[11px] text-white/70 ring-1 ring-white/10">
            Start / End
          </span>
        </div>
        <p class="mt-3 text-white/65 leading-relaxed">
          Follow teams and get notified when games start or finish - your choice. No spam.
          Just the updates you selected.
        </p>
        <div class="mt-5 rounded-2xl bg-black/25 p-4 ring-1 ring-white/10">
          <div class="text-xs text-white/55">Screenshot idea</div>
          <div class="mt-1 text-sm text-white/80">
            A team page or card showing notify toggles.
          </div>
        </div>
      </div>

      <div class="rounded-3xl border border-white/10 bg-white/5 p-6">
        <div class="flex items-center justify-between">
          <div class="text-sm font-semibold">Movies and TV</div>
          <span class="rounded-full bg-white/10 px-2 py-0.5 text-[11px] text-white/70 ring-1 ring-white/10">
            Releases
          </span>
        </div>
        <p class="mt-3 text-white/65 leading-relaxed">
          Track upcoming films, see release windows, and know when something actually drops.
        </p>
        <div class="mt-5 rounded-2xl bg-black/25 p-4 ring-1 ring-white/10">
          <div class="text-xs text-white/55">Screenshot idea</div>
          <div class="mt-1 text-sm text-white/80">
            Search results showing title + year (helps with duplicates).
          </div>
        </div>
      </div>
    </div>
  </SectionReveal>

  <SectionReveal client:visible className="mx-auto max-w-6xl px-5 py-20">
    <div class="rounded-3xl border border-white/10 bg-gradient-to-b from-white/12 via-white/8 to-white/5 p-8 md:p-10">
      <h2 class="text-3xl font-semibold tracking-tight md:text-4xl">
        Not just for shows and sports.
      </h2>
      <p class="mt-4 max-w-2xl text-white/70 leading-relaxed">
        ReleaseRadar isn't limited to entertainment.
      </p>
      <div class="mt-6 grid gap-4 md:grid-cols-2">
        <div class="rounded-2xl bg-black/25 p-5 ring-1 ring-white/10">
          <div class="text-sm font-semibold">Examples</div>
          <ul class="mt-3 space-y-2 text-sm text-white/65">
            <li>• Blog updates</li>
            <li>• Product-specific price changes</li>
            <li>• Store restocks</li>
            <li>• Release pages</li>
            <li>• Any custom web source you care about</li>
          </ul>
        </div>
        <div class="rounded-2xl bg-black/25 p-5 ring-1 ring-white/10">
          <div class="text-sm font-semibold">How it feels</div>
          <p class="mt-3 text-sm text-white/65 leading-relaxed">
            Add something once. Stop thinking about it. If it changes, it surfaces.
            If it doesn't, it stays quiet.
          </p>
          <div class="mt-4 inline-flex items-center gap-2 rounded-full bg-white/10 px-3 py-1 text-[11px] text-white/70 ring-1 ring-white/10">
            <span class="h-2 w-2 rounded-full bg-emerald-400/80" />
            Works great as a “set and forget” tracker.
          </div>
        </div>
      </div>
    </div>
  </SectionReveal>

  <section class="mx-auto max-w-6xl px-5 py-20">
    <div class="rounded-3xl border border-white/10 bg-white/5 p-10 text-center">
      <h2 class="text-3xl font-semibold tracking-tight md:text-4xl">Download ReleaseRadar</h2>
      <p class="mt-4 text-white/65">Desktop app for Windows, macOS, and Linux. Free to use.</p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a
          href={`${base}downloads`}
          class="inline-flex items-center justify-center rounded-2xl bg-white px-6 py-3 text-sm font-semibold text-black transition hover:bg-white/90"
        >
          Go to downloads
        </a>
        <a
          href={`${base}docs`}
          class="inline-flex items-center justify-center rounded-2xl border border-white/15 px-6 py-3 text-sm font-semibold text-white/80 transition hover:border-white/25 hover:text-white"
        >
          Read the docs
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
