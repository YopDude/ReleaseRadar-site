---
import BaseLayout from "../layouts/BaseLayout.astro";

const baseRaw = import.meta.env.BASE_URL || '/';
const base = baseRaw.endsWith('/') ? baseRaw : `${baseRaw}/`;
---

<BaseLayout title="About - ReleaseRadar">
  <section class="mx-auto max-w-6xl px-5 py-16 md:py-20">
    <h1 class="text-4xl font-semibold tracking-tight md:text-5xl">Why ReleaseRadar exists</h1>
    <div class="mt-8 max-w-3xl space-y-5 text-white/70 leading-relaxed">
      <p>
        Most tracking tools focus on one niche.
      </p>
      <p>
        Anime apps track anime. Sports apps track sports. RSS feeds track blogs.
        I wanted one system that handles all of it - consistently.
      </p>
      <p>
        So I built it.
      </p>
      <p>
        It's free. It runs locally. It does one job well.
      </p>
    </div>

    <div class="mt-12 grid gap-5 md:grid-cols-3">
      <div class="rounded-3xl border border-white/10 bg-white/5 p-6">
        <div class="text-sm font-semibold">No noise</div>
        <p class="mt-3 text-sm text-white/65 leading-relaxed">
          If something changes, it surfaces. If it doesn't, it stays quiet.
        </p>
      </div>
      <div class="rounded-3xl border border-white/10 bg-white/5 p-6">
        <div class="text-sm font-semibold">Works across domains</div>
        <p class="mt-3 text-sm text-white/65 leading-relaxed">
          Anime, manga, movies, sports, and custom sources - all in one place.
        </p>
      </div>
      <div class="rounded-3xl border border-white/10 bg-white/5 p-6">
        <div class="text-sm font-semibold">Yours</div>
        <p class="mt-3 text-sm text-white/65 leading-relaxed">
          Desktop app that runs locally. No subscription treadmill.
        </p>
      </div>
    </div>

    <div class="mt-14 rounded-3xl border border-white/10 bg-gradient-to-b from-white/10 to-white/5 p-8 md:p-10">
      <h2 class="text-2xl font-semibold">Contact</h2>
      <p class="mt-3 text-white/70">
        Want to report a bug or suggest a feature?
      </p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a
          href={`${base}contact`}
          class="inline-flex items-center justify-center rounded-2xl bg-white px-5 py-3 text-sm font-semibold text-black transition hover:bg-white/90"
        >
          Contact page
        </a>
        <a
          href={`${base}patch-notes`}
          class="inline-flex items-center justify-center rounded-2xl border border-white/15 px-5 py-3 text-sm font-semibold text-white/80 transition hover:border-white/25 hover:text-white"
        >
          Patch notes
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
