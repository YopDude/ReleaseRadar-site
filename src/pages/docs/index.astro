---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const entries = await getCollection("docs");

const groups = entries
  .slice()
  .sort((a, b) => (a.data.order ?? 999) - (b.data.order ?? 999))
  .reduce((acc, e) => {
    const g = e.data.group ?? "Docs";
    (acc[g] ??= []).push(e);
    return acc;
  }, /** @type {Record<string, typeof entries>} */ ({}));

const baseRaw = import.meta.env.BASE_URL || '/';
const base = baseRaw.endsWith('/') ? baseRaw : `${baseRaw}/`;
---

<BaseLayout title="Docs - ReleaseRadar">
  <section class="mx-auto max-w-6xl px-5 py-16 md:py-20">
    <h1 class="text-4xl font-semibold tracking-tight md:text-5xl">Docs</h1>
    <p class="mt-4 max-w-2xl text-white/65 leading-relaxed">
      Practical docs. No essays. Just enough to use the app properly.
    </p>

    <div class="mt-10 grid gap-10 md:grid-cols-[260px_1fr]">
      <aside class="rounded-3xl border border-white/10 bg-white/5 p-5">
        <div class="text-xs font-semibold text-white/60">On this page</div>
        <div class="mt-4 space-y-6">
          {Object.entries(groups).map(([group, items]) => (
            <div>
              <div class="text-xs font-semibold text-white/70">{group}</div>
              <div class="mt-2 space-y-1">
                {items.map((e) => (
                  <a
                    class="block rounded-xl px-3 py-2 text-sm text-white/70 transition hover:bg-black/25 hover:text-white"
                    href={`${base}docs/${e.slug}`}
                  >
                    {e.data.title}
                  </a>
                ))}
              </div>
            </div>
          ))}
        </div>
      </aside>

      <div>
        <div class="rounded-3xl border border-white/10 bg-black/25 p-6 ring-1 ring-white/10">
          <div class="text-sm font-semibold">Start here</div>
          <p class="mt-2 text-sm text-white/65 leading-relaxed">
            If you're new: read <a class="underline hover:text-white" href={`${base}docs/getting-started`}>Getting started</a>.
            If you already track lists on MAL/AniList: go straight to <a class="underline hover:text-white" href={`${base}docs/imports`}>Imports</a>.
          </p>
        </div>

        <div class="mt-6 grid gap-5 md:grid-cols-2">
          {entries
            .slice()
            .sort((a, b) => (a.data.order ?? 999) - (b.data.order ?? 999))
            .map((e) => (
              <a
                href={`${base}docs/${e.slug}`}
                class="group rounded-3xl border border-white/10 bg-white/5 p-6 transition hover:bg-white/10"
              >
                <div class="text-sm font-semibold">{e.data.title}</div>
                <p class="mt-3 text-sm text-white/65 leading-relaxed">
                  {e.data.description ?? ""}
                </p>
                <div class="mt-5 text-xs text-white/45 group-hover:text-white/60">Read →</div>
              </a>
            ))}
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
