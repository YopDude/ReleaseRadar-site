---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection, getEntry } from "astro:content";

export async function getStaticPaths() {
  const entries = await getCollection("patch-notes");
  return entries.map((e) => ({ params: { slug: e.slug } }));
}

const { slug } = Astro.params;
const entry = await getEntry("patch-notes", slug!);
if (!entry) throw new Error(`Patch note not found: ${slug}`);
const { Content } = await entry.render();

const base = import.meta.env.BASE_URL;
const fmt = new Intl.DateTimeFormat("en-NZ", { year: "numeric", month: "long", day: "2-digit" });
---

<BaseLayout title={`v${entry.data.version} — Patch notes — ReleaseRadar`}>
  <section class="mx-auto max-w-6xl px-5 py-16 md:py-20">
    <a class="text-sm text-white/55 hover:text-white" href={`${base}patch-notes`}>← Patch notes</a>

    <div class="mt-4 rounded-3xl border border-white/10 bg-white/5 p-6">
      <div class="flex flex-wrap items-baseline justify-between gap-3">
        <div class="text-lg font-semibold">v{entry.data.version}</div>
        <div class="text-xs text-white/50">{fmt.format(entry.data.date)}</div>
      </div>
      <div class="mt-2 text-2xl font-semibold tracking-tight">{entry.data.title}</div>
      {entry.data.summary && (
        <p class="mt-3 max-w-2xl text-sm text-white/65 leading-relaxed">{entry.data.summary}</p>
      )}
      {entry.data.tags?.length ? (
        <div class="mt-4 flex flex-wrap gap-2">
          {entry.data.tags.map((t) => (
            <span class="rounded-full bg-black/25 px-2 py-0.5 text-[11px] text-white/60 ring-1 ring-white/10">
              {t}
            </span>
          ))}
        </div>
      ) : null}
    </div>

    <article class="rr-markdown mt-8 rounded-3xl border border-white/10 bg-black/25 p-6 ring-1 ring-white/10">
      <Content />
    </article>
  </section>
</BaseLayout>
